# Backend configuration (all variables use the NEERAI_ prefix). Copy to .env for local use. No secrets belong in git.
# Local development needs none of these: defaults give demo agents, simulated weather, SQLite, no sign-in, inline job queue.

# --- runtime ---
NEERAI_ENV=local                  # local | aws  (aws = strict startup validation; see docs/environment.md)
NEERAI_LOG_LEVEL=INFO
NEERAI_LOG_FORMAT=text            # text | json (json in Lambda)

# --- agents / Bedrock ---
NEERAI_AGENT_MODE=demo            # demo = scripted Strands model (no AWS) | bedrock = Amazon Bedrock
NEERAI_BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0   # ap-south-1 needs the APAC inference profile
NEERAI_BEDROCK_REGION=ap-south-1  # credentials come from the default AWS chain (profile / IAM role)
NEERAI_BEDROCK_MAX_ATTEMPTS=3     # botocore standard retry mode: exponential backoff + jitter
NEERAI_AGENT_TIMEOUT_S=60
NEERAI_AGENT_MAX_TOOL_CALLS=24

# --- weather ---
NEERAI_WEATHER_PROVIDER=mock      # mock (labelled simulation) | openmeteo (strict live) | auto (live, labelled fallback)
NEERAI_WEATHER_SCENARIO=uncertain_rain

# --- storage ---
NEERAI_REPOSITORY=sql             # sql | dynamodb
NEERAI_DATABASE_URL=sqlite:///./neerai.db
NEERAI_DYNAMODB_TABLE=            # set by CDK in AWS
NEERAI_AWS_REGION=ap-south-1

# --- auth (aws env requires cognito) ---
NEERAI_AUTH_MODE=none             # none | cognito
NEERAI_COGNITO_REGION=
NEERAI_COGNITO_USER_POOL_ID=
NEERAI_COGNITO_CLIENT_ID=

# --- async jobs ---
NEERAI_QUEUE_BACKEND=inline       # inline (thread, local) | sqs
NEERAI_JOBS_QUEUE_URL=
NEERAI_JOB_TIMEOUT_S=100
NEERAI_JOB_MAX_ATTEMPTS=3
NEERAI_JOB_TTL_DAYS=7
NEERAI_MAX_ACTIVE_JOBS_PER_USER=2
NEERAI_MAX_JOBS_PER_USER_PER_DAY=40

# --- http ---
NEERAI_CORS_ORIGINS=http://localhost:5173   # aws env: only the deployed Amplify origin
NEERAI_MAX_BODY_BYTES=65536
NEERAI_RATE_LIMIT_PER_MINUTE=120            # local only; AWS uses API Gateway throttling + per-user job quotas
NEERAI_AUTO_SEED=true                       # must be false in aws env
