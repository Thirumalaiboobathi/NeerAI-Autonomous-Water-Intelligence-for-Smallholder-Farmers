# Copy to .env (backend reads NEERAI_* variables). No secrets belong in git.
NEERAI_AGENT_MODE=demo            # demo = scripted Strands model (no AWS) | bedrock = Amazon Bedrock
NEERAI_BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
NEERAI_BEDROCK_REGION=ap-south-1  # credentials come from the default AWS chain (profile / IAM role)
NEERAI_WEATHER_PROVIDER=mock      # mock | openmeteo | auto (live with labelled simulated fallback)
NEERAI_WEATHER_SCENARIO=uncertain_rain
NEERAI_DATABASE_URL=sqlite:///./neerai.db   # or postgresql+psycopg://user:pass@host/db
NEERAI_REPOSITORY=sql             # sql | dynamodb
NEERAI_DYNAMODB_TABLE=neerai-documents
NEERAI_CORS_ORIGINS=http://localhost:5173
NEERAI_RATE_LIMIT_PER_MINUTE=120
NEERAI_AGENT_TIMEOUT_S=60
NEERAI_AGENT_MAX_TOOL_CALLS=24
